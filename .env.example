# Copy to .env.local and fill in
GLM_API_KEY=your_glm_api_key_here
# Z.ai OpenAI-compatible endpoint
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-5.3-flash

# Optional — free self-hosted SearXNG makes auto-discovery reliable (no key, no limits)
# docker run -d --name searxng -p 8080:8080 -v ~/searxng:/etc/searxng searxng/searxng
# (enable JSON: settings.yml -> search.formats -> add "json")
SEARXNG_BASE_URL=
